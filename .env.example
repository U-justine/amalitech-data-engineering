# PulseGuard settings you can change (these are the defaults).
CLINIC_NAME=PulseGuard Clinic
# PowerShell example:  $env:DB_PORT="5433"
KAFKA_SERVER=localhost:9092
KAFKA_TOPIC=heartbeats
KAFKA_GROUP_ID=heartbeat-savers
KAFKA_ALERT_TOPIC=heartbeat-alerts
KAFKA_ALERT_GROUP_ID=alert-emailers
EPISODE_MIN_SECONDS=30
DB_HOST=localhost
DB_PORT=5433
DB_NAME=heartbeat
DB_USER=heartbeat
DB_PASSWORD=heartbeat

# Emails: health alerts and failures (default: Mailpit test inbox at http://localhost:8025)
EMAIL_ENABLED=yes
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=no
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=pulseguard@example.com
ALERT_TO=oncall@example.com          # health alerts (clinical staff)
SYSTEM_ALERT_TO=it-team@example.com  # system problems (IT team)

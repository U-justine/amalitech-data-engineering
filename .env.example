# copy this to .env first:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
# Airflow 3 needs these, any long random text works
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
AIRFLOW_API_SECRET_KEY=change-me-to-another-long-random-string

# MySQL staging
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=flight_staging
MYSQL_USER=staging_user
MYSQL_PASSWORD=staging_pass

# PostgreSQL analytics
ANALYTICS_PG_USER=analytics_user
ANALYTICS_PG_PASSWORD=analytics_pass
ANALYTICS_PG_DB=flight_analytics

# ---- email alerts ----
# for gmail you need an app password, your normal password won't work:
# turn on 2-step verification, then https://myaccount.google.com/apppasswords
# paste it below without the spaces. (outlook: smtp.office365.com, port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=your.name@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM=your.name@gmail.com
# more than one address: separate with commas
ALERT_EMAIL_TO=you@example.com

# seconds before a task / the run counts as slow (it still works, just a warning email)
ALERT_SLOW_LOAD_SECONDS=120
ALERT_SLOW_EXTRACT_SECONDS=120
ALERT_SLOW_TASK_SECONDS=300
ALERT_SLOW_RUN_SECONDS=900
# seconds before a task gets killed (TIMED OUT email)
LOAD_TIMEOUT_SECONDS=600
TASK_TIMEOUT_SECONDS=1800

# ---- retries ----
# how many retries, first wait in seconds (it doubles each time), and the max wait
TASK_RETRIES=3
RETRY_DELAY_SECONDS=60
MAX_RETRY_DELAY_SECONDS=600
# if the csv isn't there yet: try 3 more times, 5 min apart
SOURCE_FILE_RETRIES=3
SOURCE_FILE_RETRY_DELAY_SECONDS=300
# stop the whole run after this many seconds
DAGRUN_TIMEOUT_SECONDS=3600
# email on every retry too? (otherwise they only go to data/alerts.log)
ALERT_EMAIL_ON_RETRY=false
# email after every successful run
ALERT_EMAIL_ON_SUCCESS=false

    {
      "id": 5,
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "heartbeat-pg"
      },
      "title": "Heart rate: Athletes (age 18-40, low limit 40)",
      "description": "Patients of this profile picked in the Patient dropdown. Pick 5 or fewer to also see their own limits as dashed lines.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-pg"
          },
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT r.recorded_at AS time, r.customer_id AS metric, r.heart_rate AS value FROM readings r JOIN patients p USING (customer_id) WHERE p.profile = 'athlete' AND r.customer_id IN ($patient) AND $__timeFilter(r.recorded_at) ORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "heartbeat-pg"
          },
          "refId": "B",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT t.time, p.customer_id || ' high limit' AS metric, p.high_limit AS value FROM patients p CROSS JOIN (VALUES ($__timeFrom()::timestamptz), ($__timeTo()::timestamptz)) AS t(time) WHERE p.profile = 'athlete' AND p.customer_id IN ($patient) AND (SELECT count(*) FROM patients WHERE customer_id IN ($patient)) <= 5 UNION ALL SELECT t.time, p.customer_id || ' low limit', p.low_limit FROM patients p CROSS JOIN (VALUES ($__timeFrom()::timestamptz), ($__timeTo()::timestamptz)) AS t(time) WHERE p.profile = 'athlete' AND p.customer_id IN ($patient) AND (SELECT count(*) FROM patients WHERE customer_id IN ($patient)) <= 5 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No patient of this group picked",
          "custom": {
            "lineWidth": 1,
            "showPoints": "never",
            "drawStyle": "line",
            "spanNulls": 5000,
            "lineInterpolation": "smooth",
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* limit$"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "right"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },

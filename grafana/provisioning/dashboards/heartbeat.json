          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT avg(kafka_seconds) * 1000 FROM readings WHERE customer_id NOT LIKE 'TEST-%' AND saved_at > now() - interval '60 seconds'"
        }
